# Copy to .env.local (or set in Vercel → Settings → Environment Variables).
# Every service is optional: without Stripe the shop runs in demo mode (orders skip payment),
# without Supabase orders are kept in memory.

# Stripe, TEST keys only (sk_test_…). Live keys are ignored on purpose.
STRIPE_SECRET_KEY=
# From the webhook endpoint for /api/stripe/webhook (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=

# Supabase → Project settings → API. The service role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin.
ADMIN_PASSWORD=

# Optional: the public address, for metadata and Stripe redirects. Vercel's production URL is used otherwise.
NEXT_PUBLIC_SITE_URL=
